  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cairo",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        },
        "lineHeight": 1.25
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cairo",
        "fontSize": {
          "value": 1.375,
          "unit": "rem"
        },
        "fontWeight": 700,
        "lineHeight": 1.3
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cairo",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.35
      }
    },
    "body-lg": {
